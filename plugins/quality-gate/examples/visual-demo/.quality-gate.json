{
  "schemaVersion": "0.2",
  "claims": [
    {
      "id": "VIS-1",
      "statement": "Rendered visual artifact exactly matches the approved baseline"
    },
    {
      "id": "VIS-2",
      "statement": "Rendered visual artifact stays within the tolerated pixel budget"
    }
  ],
  "gates": [
    {
      "id": "visual",
      "kind": "visual",
      "enabled": true,
      "stages": [
        "close"
      ],
      "claimId": "VIS-1",
      "baselineFile": "baseline.svg",
      "argv": [
        "$NODE",
        "runner.mjs"
      ],
      "timeoutMs": 3000,
      "level": "L3"
    },
    {
      "id": "visual-tolerance",
      "kind": "visual",
      "enabled": true,
      "stages": [
        "close"
      ],
      "claimId": "VIS-2",
      "baselineFile": "baseline.svg",
      "argv": [
        "$NODE",
        "runner.mjs"
      ],
      "timeoutMs": 3000,
      "maxDiffPixels": 10,
      "level": "L3"
    }
  ],
  "risks": [
    {
      "id": "VIS-R1",
      "gateId": "visual",
      "description": "Exact-byte SVG snapshot is not a perceptual browser screenshot comparison"
    },
    {
      "id": "VIS-R2",
      "gateId": "visual-tolerance",
      "description": "Demo diff metric counts differing bytes; production should use a real image differ"
    }
  ],
  "exceptions": [],
  "requiredLevels": {
    "close": [
      "L3"
    ]
  }
}
